# ------------------------------------------------------------------
# SyncRoom environment variables
# Copy this file to server/.env (the server loads it automatically)
# ------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://syncroom:syncroom@localhost:5433/syncroom?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# JWT lifetime
JWT_EXPIRES_IN="7d"

# Port the API + WebSocket server listens on
PORT=4100

# Allowed browser origin (used for CORS)
CLIENT_ORIGIN="http://localhost:5174"

# Node environment
NODE_ENV="development"
